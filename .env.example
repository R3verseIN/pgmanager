# REQUIRED: PostgreSQL pgmanager user password
POSTGRES_PASSWORD=

# REQUIRED: PgBouncer auth user password
PGBOUNCER_AUTH_PASSWORD=

# OPTIONAL: Hostname/IP for user connection strings (e.g., pg.example.com:5432)
# If not set, auto-detected from the web UI's Host header.
# PGMANAGER_HOST=

# OPTIONAL: WAL-G S3 Backup Configuration
# Leave all WAL-G vars empty to disable S3 backups entirely.
# The S3 prefix must be set here for the db container's archive_command.
# All other settings (endpoint, region, interval, retention, etc.)
# are configurable from the web UI under S3 Backups.
# WALG_S3_PREFIX=s3://my-bucket/pgmanager
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_ENDPOINT=                 # For MinIO/S3-compatible: http://minio:9000
# AWS_REGION=us-east-1
# AWS_S3_FORCE_PATH_STYLE=false # Set true for MinIO
# WALG_ARCHIVE_TIMEOUT=300      # Max seconds before WAL segment is archived (default: 300)
