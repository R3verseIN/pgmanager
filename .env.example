# REQUIRED: PostgreSQL pgmanager user password
POSTGRES_PASSWORD=

# REQUIRED: PgBouncer auth user password
PGBOUNCER_AUTH_PASSWORD=

# OPTIONAL: Hostname/IP for user connection strings (e.g., pg.example.com:5432)
# If not set, auto-detected from the web UI's Host header.
# PGMANAGER_HOST=

# OPTIONAL: pgBackRest S3 Backup Configuration
# Leave all PGBACKREST_* vars empty to disable S3 backups entirely.
# PGBACKREST_REPO1_TYPE=s3
# PGBACKREST_REPO1_S3_BUCKET=my-backup-bucket
# PGBACKREST_REPO1_S3_ENDPOINT=s3.us-east-1.amazonaws.com
# PGBACKREST_REPO1_S3_REGION=us-east-1
# PGBACKREST_REPO1_S3_URI_STYLE=path
# PGBACKREST_REPO1_S3_KEY=
# PGBACKREST_REPO1_S3_KEY_SECRET=
# PGBACKREST_REPO1_PATH=/backups
