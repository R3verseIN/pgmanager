FROM postgres:17-alpine

ARG WALG_VERSION=3.0.8
ARG TARGETARCH=amd64
RUN apk add --no-cache python3 py3-pip wget gcompat && \
    pip3 install --break-system-packages --no-cache-dir psycopg2-binary && \
    wget -q "https://github.com/wal-g/wal-g/releases/download/v${WALG_VERSION}/wal-g-pg-22.04-${TARGETARCH}" \
         -O /usr/local/bin/wal-g && \
    chmod +x /usr/local/bin/wal-g && \
    apk del wget

COPY --chmod=755 scripts/pgmanager-init.py /usr/local/bin/pgmanager-init.py
COPY --chmod=755 scripts/pg-entrypoint.sh /usr/local/bin/pg-entrypoint.sh
COPY --chmod=755 init/ /docker-entrypoint-initdb.d/
COPY scripts/ /scripts/
ENTRYPOINT ["/usr/local/bin/pg-entrypoint.sh"]
CMD ["postgres"]
